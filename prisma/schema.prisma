generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Producto {
  id          String    @id @default(cuid())
  modelo      String
  categoria   Categoria
  estado      Estado
  color       String?
  memoria     String?
  bateria     String?
  precioCosto Float?
  precioVenta Float
  stock       Int       @default(1)
  visible     Boolean   @default(true)
  imagen      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  moneda      String    @default("USD")
}

enum Categoria {
  IPHONE
  MAC
  IPAD
  ACCESORIOS
  OTROS
}

enum Estado {
  NUEVO
  USADO
}


enum EstadoReparacion {
  PENDIENTE
  ENTREGADO
}
model Reparacion {
  id             String           @id @default(cuid())
  nombreCliente  String
  telefono       String
  email          String?
  dispositivo    String
  fechaIngreso   DateTime
  cobro          Float?
  costoRepuestos Float?
  descripcion    String?
  estado         EstadoReparacion @default(PENDIENTE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}





