generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Categorías fijas del catálogo (mismas que en la web pública)
enum Categoria {
  IPHONE
  MAC
  IPAD
  ACCESORIOS
  PLAY
  FUNDAS
  OTROS
}

enum Estado {
  NUEVO
  USADO
}

model Producto {
  id          String    @id @default(cuid()) // id único autogenerado
  modelo      String // ej: "iPhone 13 Pro Max"
  categoria   Categoria
  estado      Estado
  color       String? // "?" = campo opcional
  memoria     String?
  bateria     String?
  precioCosto Float?
  precioVenta Float
  moneda      String    @default("USD")
  stock       Int       @default(1)
  visible     Boolean   @default(true)
  imagen      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ventas      Venta[]
}

model Venta {
  id             String   @id @default(cuid())
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cantidad       Int
  precioUnitario Float
  total          Float
  createdAt      DateTime @default(now())
}
